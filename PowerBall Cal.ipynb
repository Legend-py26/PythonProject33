    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"from itertools import combinations\\n\",\n",
    "    \"from collections import Counter\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# columns that make up one drawing\\n\",\n",
    "    \"number_cols = freq\\n\",\n",
    "    \"\\n\",\n",
    "    \"all_triplets = []\\n\",\n",
    "    \"\\n\",\n",
    "    \"# go drawing by drawing (row by row)\\n\",\n",
    "    \"for _, row in dataframe[number_cols].iterrows():\\n\",\n",
    "    \"    numbers = sorted(row.dropna().tolist())\\n\",\n",
    "    \"\\n\",\n",
    "    \"    # all unique 3-number combinations from THIS drawing\\n\",\n",
    "    \"    all_triplets.extend(combinations(numbers, 2))\\n\",\n",
    "    \"\\n\",\n",
    "    \"# count how often each triplet appears across all drawings\\n\",\n",
    "    \"triplet_frequency = Counter(all_triplets)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# ✅ ONLY keep triplets that appear more than once\\n\",\n",
    "    \"repeated_triplets = [\\n\",\n",
    "    \"    triplet for triplet, count in triplet_frequency.items()\\n\",\n",
    "    \"    if count > 1\\n\",\n",
    "    \"]\"\n",
