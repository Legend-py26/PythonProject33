    "    \"from itertools import combinations\\n\",\n",
    "    \"def PowerBall_Combinations():\\n\",\n",
    "    \"    nums_range = range(1, 70)\\n\",\n",
    "    \"    possible_combinations = combinations(nums_range, 5)\\n\",\n",
