    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"import random\\n\",\n",
    "    \"\\n\",\n",
    "    \"def generate_unseen(history, n=10):\\n\",\n",
    "    \"    history_set = set(tuple(sorted(draw)) for draw in history)\\n\",\n",
    "    \"\\n\",\n",
    "    \"    results = set()\\n\",\n",
    "    \"\\n\",\n",
    "    \"    while len(results) < n:\\n\",\n",
    "    \"        combo = tuple(sorted(random.sample(range(1, 70), 5)))  # NOT sorted\\n\",\n",
    "    \"\\n\",\n",
    "    \"        if tuple(sorted(combo)) not in history_set:\\n\",\n",
    "    \"            results.add(combo)  # keeps unique results\\n\",\n",
    "    \"\\n\",\n",
    "    \"    return results\\n\",\n",
    "    \"\\n\",\n",
    "    \"\\n\",\n",
    "    \"# usage\\n\",\n",
    "    \"unseen_10 = generate_unseen(d3, 10)\\n\",\n",
    "    \"\\n\",\n",
    "    \"for combo in unseen_10:\\n\",\n",
    "    \"    print(combo)\"\n",
